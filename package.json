{
  "name": "@tom2012/dsh-monitor",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin: local and remote server CPU/memory/disk readout under the composer, with a Monitor tab in Settings",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "monitor",
    "metrics",
    "cpu",
    "memory",
    "disk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zbc0315/dsh-monitor.git"
  },
  "homepage": "https://github.com/zbc0315/dsh-monitor#readme",
  "bugs": {
    "url": "https://github.com/zbc0315/dsh-monitor/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
